# ─── Required ────────────────────────────────────────────────────────────────
# Public URL of the app, without a trailing slash. Must exactly match the origin
# of the OAuth redirect URI registered in Google Cloud:
#   ${APP_BASE_URL}/api/auth/google/callback
APP_BASE_URL=http://localhost:3000

# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Random secret (32+ characters) used to encrypt session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# ─── Optional ────────────────────────────────────────────────────────────────
# Support contact shown on the Privacy, Terms and Support pages.
SUPPORT_EMAIL=

# Rate limits (per server instance).
RATE_LIMIT_AUTH_PER_IP=20          # sign-in attempts per IP per 10 minutes
RATE_LIMIT_CREATE_PER_USER=10      # forms per Google account per hour
RATE_LIMIT_CREATE_PER_IP=60        # forms per IP per hour (schools share IPs)

# ─── Automated tests only — never set these in production ───────────────────
# ALLOW_TEST_OVERRIDES=1
# GOOGLE_FORMS_API_ROOT_URL_TEST_ONLY=http://127.0.0.1:4010/
